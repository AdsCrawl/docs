  "keyFeatures": [
    "Rendered HTML & Markdown extraction via POST /html",
    "Full-page and element-level screenshots via POST /screenshot",
    "SPA structured data extraction with DOM and network field targeting",
    "Remote CDP sessions compatible with Playwright, Puppeteer, and raw CDP",
    "Cloud Browser profiles with saved cookies, fingerprints, and proxy settings",
    "Residential proxy routing with 100+ country/region options",
    "Browser fingerprint randomization (canvas, WebGL, WebRTC, fonts, etc.)",
    "CAPTCHA solving for reCAPTCHA, Turnstile, and AWS WAF",
    "Pre-built site templates (SimilarWeb, Google Trends, Chrome Web Store)"
  ],
  "publicApiSurface": [
    "POST /html",
    "POST /screenshot",
    "POST /spa-extract",
    "GET /spa-extract/templates",
    "POST /cdp/sessions",
    "GET /cdp/sessions",
    "DELETE /cdp/sessions/:sessionId",
    "GET /cdp/sessions/:sessionId/json/version",
    "WS /cdp/sessions/:sessionId/devtools/browser/:browserId",
    "POST /cdp/live-token",
    "WS /cdp/live/:sessionId",
    "GET /cloud-browsers",
    "POST /cloud-browsers",
    "POST /cloud-browsers/launch",
    "GET /cloud-browsers/:id",
    "POST /cloud-browsers/:id/start",
    "POST /cloud-browsers/:id/stop"
  ]
}
